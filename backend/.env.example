# Copy to .env for local development. On Render these are set in the dashboard (see render.yaml).

# SQLite works out of the box locally. For Postgres/Supabase use the Session pooler URI, e.g.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./kumbuka.db

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Don't change it once in use: it also encrypts two-step sign-in secrets.
SECRET_KEY=

# How long a sign-in lasts (hours), and minutes of inactivity before the app locks
TOKEN_HOURS=12
IDLE_LOCK_MINUTES=15

# Appointment times are stored in this timezone's wall-clock time
APP_TIMEZONE=Africa/Nairobi

# Optional. Without a key the app works fully; AI drafting and AI summaries are just off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Frontend origin(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173

# first = only the first account can be created (recommended) | true = anyone | false = nobody
ALLOW_REGISTRATION=first
